{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "durableboy-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONSOLES",
        "class_name": "ConsoleDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConsoleDO"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "DURABLEBOY_DATA",
      "bucket_name": "durableboy-test-data",
    },
  ],
}
